          "rowspan": 1,
          "colspan": 1,
          "isMergedContinue": false,
          "sourcePage": 35,
          "sourceXmlPath": "pdf:page=35;table=11;row=4;col=0",
          "logicalRowId": "p35-t0011-r4"
        },
        {
          "cellId": "p35-t0011-r4-c1",
          "row": 4,
          "column": 1,
          "rawText": "技术评分\n标准",
          "normalizedText": "",
          "rowspan": 1,
          "colspan": 1,
          "isMergedContinue": false,
          "sourcePage": 35,
          "sourceXmlPath": "pdf:page=35;table=11;row=4;col=1",
          "logicalRowId": "p35-t0011-r4"
        },
        {
          "cellId": "p35-t0011-r4-c2",
          "row": 4,
          "column": 2,
          "rawText": "针对办公用品的\n综合服务方案\n（10分）",
          "normalizedText": "",
          "rowspan": 1,
          "colspan": 1,
          "isMergedContinue": false,
          "sourcePage": 35,
          "sourceXmlPath": "pdf:page=35;table=11;row=4;col=2",
          "logicalRowId": "p35-t0011-r4"
        },
        {
          "cellId": "p35-t0011-r4-c3",
          "row": 4,
          "column": 3,
          "rawText": "的一致性管控）、出库配送\n保障（包括但不限于配送物流保障、配送商品与订单的一致\n性、物流异常处理、大件/易碎等特殊商品的物流保障等）等；\n3.综合考察供应商售后服务能力，须提供售后服务方案，包括\n但不限于标配售后安装服务保障、退换货响应、三包服务、热\n线服务、商品开票服务、收款确认、报修响应及上门服务流\n程、售后问题处理周期、普通纠纷解决方案及周期、重大物流",
          "normalizedText": "",
          "rowspan": 1,
          "colspan": 1,
          "isMergedContinue": false,
          "sourcePage": 35,
          "sourceXmlPath": "pdf:page=35;table=11;row=4;col=3",
          "logicalRowId": "p35-t0011-r4"
        }
      ],
      "isScoreTable": false
