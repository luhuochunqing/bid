        {
          "cellId": "p35-t0011-r0-c3",
          "row": 0,
          "column": 3,
          "rawText": "注：供应商须提供2023年度、2024年度、2025年度经会计师\n事务所或审计机构审计的近年财务会计报表复印件，包括资产\n负债表、现金流量表、利润表。（供应商的成立时间少于该规\n定年份的，应提供成立以来的财务会计报表）",
          "normalizedText": "",
          "rowspan": 1,
          "colspan": 1,
          "isMergedContinue": false,
          "sourcePage": 35,
          "sourceXmlPath": "pdf:page=35;table=11;row=0;col=3",
          "logicalRowId": "p34-t0010-r3"
        },
        {
          "cellId": "p35-t0011-r4-c0",
          "row": 4,
          "column": 0,
          "rawText": "3.2.3\n（2）",
